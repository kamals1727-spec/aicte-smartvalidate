# ─────────────────────────────────────────────────────────────
# AICTE SmartValidate — environment template (placeholders only)
# Copy to .env.local (local dev) and fill in. NEVER commit real values.
# ─────────────────────────────────────────────────────────────

# Database. Local: a SQLite file inside prisma/. Hosted: a Turso/libSQL URL (libsql://...).
DATABASE_URL="file:./dev.db"
# Only needed for Turso/libSQL hosted databases.
DATABASE_AUTH_TOKEN=

# Session signing secret. REQUIRED in production. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# ── AI provider ──────────────────────────────────────────────
# auto (default) = Gemini if configured, else Anthropic if configured, else DEMO mode.
# Allowed: auto | gemini | anthropic | mock
AI_PROVIDER=auto

# Google Gemini (free tier key from https://aistudio.google.com). Leave empty for DEMO mode.
GEMINI_API_KEY=
# Model ID shown as available/free in your AI Studio account (e.g. a "Flash" model). Leave empty for DEMO mode.
GEMINI_MODEL=

# Anthropic Claude (optional, paid). Leave empty if unused.
ANTHROPIC_API_KEY=
# Model ID from https://docs.claude.com (models overview). Leave empty if unused.
ANTHROPIC_MODEL=

AI_TIMEOUT_MS=60000
AI_MAX_RETRIES=2
AI_MAX_OUTPUT_TOKENS=2048
# Max characters of extracted text sent to the AI per document (data minimisation).
AI_MAX_DOC_CHARS=6000

# ── Documents ────────────────────────────────────────────────
# local = private folder on disk (default for local dev); database = bytes stored in DB
# (use "database" on serverless hosts like Vercel, which have no persistent disk).
STORAGE_DRIVER=local
UPLOAD_DIR=./storage/uploads
# Vercel serverless request bodies are limited to ~4.5 MB — keep this at 4 there.
MAX_UPLOAD_MB=10
# Pages with fewer extracted characters than this are sent to OCR.
OCR_MIN_TEXT_CHARS=40
